{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git push:*)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git pull:*)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git fetch:*)",
      "Bash(git fetch *)",
      "Bash(git remote:*)",
      "Bash(git remote *)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  }
}
